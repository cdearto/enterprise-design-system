{
  // src/docs.ts compiles to components/_shared/docs.js, the classic script
  // every page loads. It has no imports, so it stays a plain script.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "components/_shared",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "newLine": "lf",
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
